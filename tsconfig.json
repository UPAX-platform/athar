{
  "compilerOptions": {
    "target": "ES2022",
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@upax/athar/browser": ["./src/browser.ts"],
      "@upax/athar/react": ["./src/react.tsx"],
      "@upax/athar/svelte": ["./src/svelte.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "@sveltejs/kit"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "test", "tsup.config.ts", "vitest.config.ts"]
}
